generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  RECEPTIONIST
}

enum DeviceCategory {
  CELULAR
  TABLET
  LAPTOP
  CONSOLA
  TARJETA_ELECTRONICA
  OTRO
}

enum ServiceOrderStatus {
  RECIBIDO
  ESPERA_DIAGNOSTICO
  EN_DIAGNOSTICO
  ESPERA_AUTORIZACION
  ESPERA_PIEZA
  EN_REPARACION
  EN_PRUEBAS
  LISTO_ENTREGA
  ENTREGADO
  CANCELADO
  SIN_REPARACION
}

enum Priority {
  NORMAL
  ALTA
  URGENTE
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum PaymentType {
  DEPOSIT
  PARTIAL
  FINAL
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum AppointmentType {
  RECEIVING
  DELIVERY
  APPOINTMENT
  WORK
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TechnicalDocumentCategory {
  SOLUTION
  MEASUREMENT
  DIAGRAM
  DATASHEET
  PROCEDURE
  KNOWN_ERROR
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum AttachmentCategory {
  PHOTO
  DOCUMENT
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]
  orders    ServiceOrder[]
  appointments Appointment[]
  quotations Quotation[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(TECHNICIAN)
  active    Boolean  @default(true)
  avatarKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedOrders ServiceOrder[] @relation("AssignedOrders")
  notifications Notification[]
  createdQuotations Quotation[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
}

model Device {
  id           String         @id @default(cuid())
  customerId   String
  category     DeviceCategory
  brand        String
  model        String
  serialNumber String?
  imei         String?
  color        String?
  notes        String?
  createdAt    DateTime       @default(now())
  customer     Customer       @relation(fields: [customerId], references: [id])
  orders       ServiceOrder[]
  quotations   Quotation[]
}

model ServiceOrder {
  id                    String             @id @default(cuid())
  folio                 String             @unique
  publicTrackingToken   String             @unique @default(cuid())
  customerId            String
  deviceId              String
  assignedTechnicianId  String?
  status                ServiceOrderStatus @default(RECIBIDO)
  priority              Priority           @default(NORMAL)
  reportedIssue         String
  diagnosis             String?
  probableCause         String?
  testChecklist         Json?
  estimatedCost         Decimal?           @db.Decimal(12, 2)
  finalCost             Decimal?           @db.Decimal(12, 2)
  partsCost             Decimal            @default(0) @db.Decimal(12, 2)
  laborCost             Decimal            @default(0) @db.Decimal(12, 2)
  otherCharges          Decimal            @default(0) @db.Decimal(12, 2)
  budgetStatus          BudgetStatus      @default(PENDING)
  receivedAt            DateTime           @default(now())
  estimatedDeliveryAt   DateTime?
  deliveredAt           DateTime?
  warrantyDays          Int?
  warrantyExpiresAt     DateTime?
  warrantyForOrderId    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  customer              Customer           @relation(fields: [customerId], references: [id])
  device                Device             @relation(fields: [deviceId], references: [id])
  assignedTechnician    User?              @relation("AssignedOrders", fields: [assignedTechnicianId], references: [id])
  warrantyForOrder      ServiceOrder?      @relation("OrderWarranty", fields: [warrantyForOrderId], references: [id])
  warrantyClaims        ServiceOrder[]     @relation("OrderWarranty")
  statusHistory         StatusHistory[]
  payments              Payment[]
  parts                 OrderPart[]
  appointments          Appointment[]
  technicalNotes        TechnicalNote[]
  attachments           OrderAttachment[]
  quotation             Quotation?

  @@index([status])
  @@index([customerId])
  @@index([warrantyForOrderId])
}

model Quotation {
  id               String          @id @default(cuid())
  folio            String          @unique
  customerId       String
  deviceId         String
  issueDescription String
  notes            String?
  status           QuotationStatus @default(DRAFT)
  validUntil       DateTime?
  createdById      String?
  serviceOrderId   String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customer         Customer        @relation(fields: [customerId], references: [id])
  device           Device          @relation(fields: [deviceId], references: [id])
  createdBy        User?           @relation(fields: [createdById], references: [id])
  serviceOrder     ServiceOrder?   @relation(fields: [serviceOrderId], references: [id])
  items            QuotationItem[]

  @@index([status])
  @@index([customerId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  @@index([quotationId])
}

model OrderAttachment {
  id             String             @id @default(cuid())
  serviceOrderId String
  fileName       String
  key            String             @unique
  mimeType       String
  size           Int
  category       AttachmentCategory @default(PHOTO)
  createdAt      DateTime           @default(now())
  serviceOrder   ServiceOrder       @relation(fields: [serviceOrderId], references: [id])

  @@index([serviceOrderId, createdAt])
}

model Appointment {
  id             String            @id @default(cuid())
  title          String
  type           AppointmentType
  status         AppointmentStatus @default(SCHEDULED)
  startsAt       DateTime
  endsAt         DateTime
  notes          String?
  customerId     String?
  serviceOrderId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  customer       Customer?         @relation(fields: [customerId], references: [id])
  serviceOrder   ServiceOrder?     @relation(fields: [serviceOrderId], references: [id])

  @@index([startsAt])
  @@index([status])
}

model TechnicalDocument {
  id          String                    @id @default(cuid())
  title       String
  category    TechnicalDocumentCategory
  deviceBrand String?
  deviceModel String?
  description String
  keywords    String?
  fileUrl     String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  notes       TechnicalNote[]

  @@index([deviceBrand, deviceModel])
  @@index([category])
}

model TechnicalNote {
  id                 String             @id @default(cuid())
  technicalDocumentId String?
  serviceOrderId     String?
  title              String
  content            String
  measurements       String?
  createdAt          DateTime           @default(now())
  technicalDocument  TechnicalDocument? @relation(fields: [technicalDocumentId], references: [id])
  serviceOrder       ServiceOrder?      @relation(fields: [serviceOrderId], references: [id])
}

model Payment {
  id             String        @id @default(cuid())
  serviceOrderId String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  type           PaymentType
  reference      String?
  createdAt      DateTime      @default(now())
  serviceOrder   ServiceOrder  @relation(fields: [serviceOrderId], references: [id])

  @@index([serviceOrderId, createdAt])
}

model InventoryItem {
  id           String              @id @default(cuid())
  name         String
  sku          String              @unique
  category     String
  cost         Decimal             @db.Decimal(12, 2)
  salePrice    Decimal             @db.Decimal(12, 2)
  stock        Int                 @default(0)
  minimumStock Int                 @default(0)
  supplierId   String?
  imageKey     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  movements    InventoryMovement[]
  orderParts   OrderPart[]
  purchaseLines PurchaseOrderLine[]
  priceHistory  InventoryPriceHistory[]
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])

  @@index([category])
}

enum PriceChangeSource {
  MANUAL
  PURCHASE_ORDER
}

model InventoryPriceHistory {
  id                String            @id @default(cuid())
  inventoryItemId   String
  previousCost      Decimal           @db.Decimal(12, 2)
  newCost           Decimal           @db.Decimal(12, 2)
  previousSalePrice Decimal           @db.Decimal(12, 2)
  newSalePrice      Decimal           @db.Decimal(12, 2)
  source            PriceChangeSource
  reference         String?
  createdAt         DateTime          @default(now())
  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId, createdAt])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     InventoryItem[]
  purchaseOrders PurchaseOrder[]
}

model ServiceCatalogItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model PurchaseOrder {
  id         String             @id @default(cuid())
  folio      String             @unique
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  lines      PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model OrderPart {
  id              String        @id @default(cuid())
  serviceOrderId  String
  inventoryItemId String
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  serviceOrder    ServiceOrder  @relation(fields: [serviceOrderId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([serviceOrderId])
}

model InventoryMovement {
  id              String              @id @default(cuid())
  inventoryItemId String
  type            InventoryMovementType
  quantity        Int
  note            String?
  createdAt       DateTime            @default(now())
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId, createdAt])
}

model StatusHistory {
  id            String             @id @default(cuid())
  serviceOrderId String
  previousStatus ServiceOrderStatus?
  newStatus      ServiceOrderStatus
  note           String?
  createdAt      DateTime           @default(now())
  serviceOrder   ServiceOrder        @relation(fields: [serviceOrderId], references: [id])

  @@index([serviceOrderId, createdAt])
}
